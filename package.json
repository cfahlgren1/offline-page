{
  "name": "offline-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run check && vite build && node scripts/write-service-worker.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt && prettier --write \"src/**/*.svelte\"",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.svelte\"",
    "brand": "node brand/render.mjs",
    "deploy": "bash scripts/deploy-space.sh",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@pierre/highlights": "^0.5.1",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "onnxruntime-web": "^1.20.1",
    "tinyfix": "^0.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
