{
  "name": "offline-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build && node scripts/write-service-worker.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "brand": "node brand/render.mjs",
    "deploy": "bash scripts/deploy-space.sh",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "onnxruntime-web": "^1.20.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.8"
  }
}
